        const termInput = document.getElementById('terminal-input');
        const termBody = document.getElementById('terminal-body');
        const sourceDialog = document.getElementById('source-dialog');
        const sourceCode = document.getElementById('source-code');
        const closeSource = document.getElementById('close-source');
        const termPrompt = document.getElementById('term-prompt');

        let isVimMode = false;
        let isPasswordMode = false;
        let isRootMode = false;
        let sudoAttempts = 0;
        let currentPath = '/';
        let hasBooted = false;
        let commandHistory = JSON.parse(localStorage.getItem('term-history') || '[]');
        let historyIndex = -1;
        const availableCommands = ['whoami', 'skills', 'code', 'matrix', 'gravity', 'arkanoid', 'tty', 'play', 'ls', 'cd', 'cat', 'submit', 'status', 'clear', 'exit', 'theme', 'github', 'linkedin', 'neofetch', 'help', 'chaos', 'legacy', 'tcpdump', 'sudo', 'ping', 'traceroute', 'listen'];

        const vfs = {
          '/': { type: 'dir', children: ['about/', 'projects/', 'skills/', 'secret.txt'] },
          '/about/': { type: 'dir', children: ['bio.txt', 'goals.txt'] },
          '/about/bio.txt': { type: 'file', content: 'Andrea Osma - Systems and Cybersecurity Engineer.' },
          '/about/goals.txt': { type: 'file', content: 'Building secure systems and beautiful interfaces.' },
          '/projects/': { type: 'dir', children: ['CampusPilot.txt', 'Homelab.txt'] },
          '/projects/CampusPilot.txt': { type: 'file', content: 'Campus Pilot: Smart mobility for universities.' },
          '/projects/Homelab.txt': { type: 'file', content: 'Homelab: Personal data center with NixOS and Nomad.' },
          '/skills/': { type: 'dir', children: ['tech.txt'] },
          '/skills/tech.txt': { type: 'file', content: 'NixOS, Nomad, Docker, Astro, TypeScript, Cibersec.' },
          '/secret.txt': { type: 'file', content: 'flag{w3lc0m3_t0_th3_m4tr1x}' }
        };

        let foundFlags = JSON.parse(localStorage.getItem('ctf-flags') || '[]');
        const ALL_FLAGS = [
          'flag{w3lc0m3_t0_th3_m4tr1x}',
          'flag{n1x0s_n0d3_s3cur3d}',
          'flag{t0uch_1d_byp4ss_f41l3d}',
          'flag{st4rm4n_w41t1ng_1n_th3_sky}'
        ];

        const addTermLine = (text, type = '') => {
          const div = document.createElement('div');
          div.className = `term-line ${type}`;
          div.innerHTML = text;
          termBody.appendChild(div);
          termBody.scrollTop = termBody.scrollHeight;
          return div;
        };

        const bootSequence = async () => {
          hasBooted = true;
          termBody.innerHTML = '';
          const lines = [
            'Loading AndreaOS kernel 6.12.0-x86_64...',
            'Mounting VFS... OK',
            'Initializing system services...',
            'Starting Zsh 5.9...',
            'AndreaOS v1.8.6 (LTS) - Authorized Access Only.',
            '<span style="opacity: 0.6;">[DISCLAIMER: This is a JS-based simulation, not a real shell.]</span>',
            'Type "help" for a list of commands.'
          ];
          for (const line of lines) {
            addTermLine(line);
            await new Promise(r => setTimeout(r, Math.random() * 80 + 30));
          }
        };

        const openTerminal = () => { 
          termDialog.showModal(); 
          if (!hasBooted) bootSequence();
          termInput.focus(); 
        };
        const closeTerminal = () => { termDialog.close(); termInput.value = ''; isVimMode = false; document.body.classList.remove('tty-mode'); };

