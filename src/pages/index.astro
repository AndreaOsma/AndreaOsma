---
import '../styles/global.css';
import { marked } from 'marked';
import { ClientRouter } from 'astro:transitions';

const githubUsername = 'AndreaOsma';
const githubApi = `https://api.github.com/users/${githubUsername}/repos?per_page=100&sort=updated`;
const readmeUrl = `https://raw.githubusercontent.com/AndreaOsma/${githubUsername}/main/README.md`;

let githubFeatured = [];
let readmeHtml = '';

try {
  // Fetch Repos
  const repoResponse = await fetch(githubApi, {
    headers: {
      Accept: 'application/vnd.github+json',
      'User-Agent': 'andreaosma-portfolio'
    }
  });

  if (repoResponse.ok) {
    const repos = await repoResponse.json();
    githubFeatured = repos
      .filter((repo) => !repo.fork)
      .sort((a, b) => {
        if (b.stargazers_count !== a.stargazers_count) {
          return b.stargazers_count - a.stargazers_count;
        }
        return new Date(b.updated_at).getTime() - new Date(a.updated_at).getTime();
      })
      .slice(0, 6);
  }

  // Fetch README
  const readmeResponse = await fetch(readmeUrl);
  if (readmeResponse.ok) {
    const markdown = await readmeResponse.text();
    readmeHtml = await marked.parse(markdown);
  }
} catch (e) {
  console.error('Error fetching data:', e);
}
