        document.getElementById('toolbar-terminal-btn')?.addEventListener('click', openTerminal);
        document.getElementById('term-dot-red')?.addEventListener('click', closeTerminal);
        document.getElementById('term-dot-yellow')?.addEventListener('click', closeTerminal);
        document.getElementById('term-dot-green')?.addEventListener('click', () => {
          document.body.classList.toggle('tty-mode');
        });

        window.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); termDialog.open ? closeTerminal() : openTerminal(); }
        });

        // --- MOBILE GESTURE (Pull Down to Open Terminal) ---
        let touchStartY = 0;
        document.addEventListener('touchstart', (e) => {
          touchStartY = e.touches[0].clientY;
        }, { passive: false });

        document.addEventListener('touchmove', (e) => {
          const touchY = e.touches[0].clientY;
          const pullDistance = touchY - touchStartY;
          if (window.scrollY <= 0 && pullDistance > 0) { e.preventDefault(); }
        }, { passive: false });

        document.addEventListener('touchend', (e) => {
          const touchEndY = e.changedTouches[0].clientY;
          const pullDistance = touchEndY - touchStartY;
          if (window.scrollY <= 0 && pullDistance > 120) {
            if (!termDialog.open) openTerminal();
          }
        });

        const enterVim = () => {
          isVimMode = true;
          termBody.innerHTML = `<div class='term-line'>~</div><div class='term-line'>~&nbsp;&nbsp;VIM - Vi IMproved</div><div class='term-line'>~</div><div class='term-line'>~&nbsp;&nbsp;type :q&lt;Enter&gt; to exit</div>`;
          termInput.placeholder = "Escritura bloqueada. Usa comandos de Vim.";
        };

        const playStarman = () => {
          try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            const ctx = new AudioContext();
            const F4 = 349.23, G4 = 392.00, A4 = 440.00, Bb4 = 466.16, C5 = 523.25, D5 = 587.33, E5 = 659.25, F5 = 698.46;
            const score = [
              {f: A4, d: 0.25}, {f: G4, d: 0.25}, {f: F4, d: 0.5}, {f: F5, d: 0.5}, 
              {f: E5, d: 0.25}, {f: D5, d: 0.25}, {f: C5, d: 0.25}, {f: D5, d: 0.25}, 
              {f: C5, d: 0.75}, {f: 0, d: 0.25},
              {f: A4, d: 0.25}, {f: C5, d: 0.25}, {f: A4, d: 0.25}, {f: C5, d: 0.25}, 
              {f: A4, d: 0.25}, {f: G4, d: 0.25}, {f: F4, d: 0.25}, {f: G4, d: 0.5},
              {f: 0, d: 0.25},
              {f: A4, d: 0.25}, {f: Bb4, d: 0.25}, {f: A4, d: 0.25}, {f: G4, d: 0.25}, 
              {f: F4, d: 0.25}, {f: G4, d: 0.25}, {f: A4, d: 0.25}, {f: F4, d: 0.75}
            ];
            let time = ctx.currentTime;
            addTermLine('Synthesizing AUTHENTIC Starman (120 BPM)...', 'success');
            score.forEach(n => {
              if (n.f > 0) {
                [n.f, n.f * 1.003].forEach(freq => {
                  const osc = ctx.createOscillator();
                  const gain = ctx.createGain();
                  osc.type = 'square';
                  osc.frequency.setValueAtTime(freq, time);
                  gain.gain.setValueAtTime(0.04, time);
                  gain.gain.exponentialRampToValueAtTime(0.0001, time + n.d);
                  osc.connect(gain); gain.connect(ctx.destination);
                  osc.start(time); osc.stop(time + n.d);
                });
              }
              time += n.d;
            });
          } catch(e) { addTermLine('Audio error.', 'error'); }
        };

        const executeCommand = (input) => {
          const rawInput = input.trim();
          if (rawInput === '') return;
          
          if (isPasswordMode) {
            if (rawInput === 'st4rm4n' || rawInput === 'root' || ALL_FLAGS.includes(rawInput)) {
              isRootMode = true; isPasswordMode = false; termInput.type = "text";
              termPrompt.textContent = "root@osma:#"; termPrompt.style.color = "#ff5f56";
              termHeader.classList.add('root-mode');
              addTermLine('Access Granted. Welcome, Architect.', 'success');
            } else {
              sudoAttempts++;
              if (sudoAttempts >= 3) {
                addTermLine('SECURITY BREACH. ACCESS LOCKED.', 'error');
                document.body.classList.add('glitch-mode');
                setTimeout(() => location.reload(), 4000);
              } else { addTermLine('Access Denied. Try again.', 'error'); }
            }
            return;
          }

          commandHistory.unshift(rawInput);
          if (commandHistory.length > 50) commandHistory.pop();
          localStorage.setItem('term-history', JSON.stringify(commandHistory));
          historyIndex = -1;

          if (isVimMode) {
            if ([':q', ':q!', ':wq', ':x'].includes(rawInput)) {
              isVimMode = false; termInput.placeholder = "..."; termBody.innerHTML = ''; addTermLine('Exited Vim.');
            } else { addTermLine(`Vim: No command '${rawInput}' found. Type :q to exit.`, 'error'); }
            return;
          }

          const args = rawInput.split(' ');
          const cmd = args[0].toLowerCase();
          addTermLine(`<span class="term-prompt">${isRootMode ? 'root@osma:#' : 'andrea@osma:' + currentPath + '$'}</span> ${rawInput}`);
          termInput.value = '';

          if (cmd === 'help' || cmd === '?') {
            const helpText = [
              '<br/><strong style="color:var(--accent)">System & Security</strong>',
              '&nbsp;&nbsp;tcpdump&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- Simulate network packet sniffing',
              '&nbsp;&nbsp;sudo su&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- Attempt privilege escalation',
              '&nbsp;&nbsp;tty&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- Switch to CLI-only mode',
              '&nbsp;&nbsp;ls, cd, cat&nbsp;- Navigate Virtual File System',
              '&nbsp;&nbsp;ping, traceroute&nbsp;- Network diagnostics',
              '<br/><strong style="color:var(--accent)">General Info</strong>',
              '&nbsp;&nbsp;whoami, skills, neofetch, theme, github, linkedin, code',
              '<br/><strong style="color:var(--accent)">Easter Eggs</strong>',
              '&nbsp;&nbsp;play starman, gravity, arkanoid, matrix, legacy, chaos, listen',
              '<br/><strong style="color:var(--accent)">CTF</strong>',
              '&nbsp;&nbsp;submit [flg], status'
            ];
            helpText.forEach(line => addTermLine(line));
          }
          else if (cmd === 'whoami') addTermLine('Andrea Osma - Systems & Cybersecurity Engineer');
          else if (cmd === 'skills') addTermLine('Frontend, DevSecOps, Cloud Security, NixOS, Nomad, Docker, Cibersec.');
          else if (cmd === 'neofetch') {
             addTermLine('<pre style="color:var(--accent); line-height:1; font-size:0.75rem;">       .---.       OS: AndreaOS 1.8.6\n      /     \\      Kernel: 6.12.0-nixos\n      | () () |     CPU: i5-9400F\n       \\  ^  /      RAM: 1.6GB / 48GB\n        |||||       Host: andreaosma.com</pre>');
          }
          else if (cmd === 'ping') {
            const target = args[1] || 'google.com';
            addTermLine(`PING ${target} (142.250.184.238): 56 data bytes`);
            let pings = 0;
            const pi = setInterval(() => {
              addTermLine(`64 bytes from 142.250.184.238: icmp_seq=${pings} ttl=117 time=${(Math.random()*15+10).toFixed(3)} ms`);
              pings++;
              if (pings >= 4) { clearInterval(pi); addTermLine(`--- ${target} ping statistics ---<br/>4 packets transmitted, 4 packets received, 0.0% packet loss`); }
            }, 500);
          }
          else if (cmd === 'traceroute') {
            const target = args[1] || 'andreaosma.com';
            addTermLine(`traceroute to ${target}, 30 hops max, 60 byte packets`);
            [
              '1  gateway.homelab (192.168.1.1)  1.234 ms',
              '2  10.234.0.1 (10.234.0.1)  2.456 ms',
              '3  nixos-node.local (192.168.1.185)  3.123 ms',
              '4  * * *',
              '5  final-destination.com (1.3.3.7)  15.678 ms'
            ].forEach((hop, i) => setTimeout(() => addTermLine(hop), i * 300));
          }
          else if (cmd === 'listen') {
             addTermLine('Requesting microphone access for signal analysis...', 'success');
             navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
               addTermLine('Surveillance mode active. Signal detected.', 'success');
               const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
               const analyser = audioCtx.createAnalyser();
               const source = audioCtx.createMediaStreamSource(stream);
               source.connect(analyser);
               analyser.fftSize = 32;
               const bufferLength = analyser.frequencyBinCount;
               const dataArray = new Uint8Array(bufferLength);
               const visualLine = addTermLine('Signal: ', 'success');
               const draw = () => {
                 if (!termDialog.open) { stream.getTracks().forEach(t => t.stop()); return; }
                 analyser.getByteFrequencyData(dataArray);
                 let bars = '';
                 for(let i=0; i<8; i++) bars += '|'.repeat(dataArray[i]/32) + '.'.repeat(Math.max(0, 8 - dataArray[i]/32));
                 visualLine.innerHTML = `Signal: <span style="font-family:monospace">${bars}</span>`;
                 requestAnimationFrame(draw);
               };
               draw();
             }).catch(() => addTermLine('Access denied.', 'error'));
          }
          else if (cmd === 'theme') { toggleTheme(); addTermLine('Theme toggled.'); }
          else if (cmd === 'github') { window.open('https://github.com/AndreaOsma', '_blank'); addTermLine('Opening GitHub...'); }
          else if (cmd === 'linkedin') { window.open('https://linkedin.com/in/AndreaOsmaRafael', '_blank'); addTermLine('Opening LinkedIn...'); }
          else if (cmd === 'sudo' && args[1] === 'su') { isPasswordMode = true; termInput.type = "password"; addTermLine('Password:'); }
          else if (cmd === 'tcpdump') {
            addTermLine('Listening on eth0...', 'success');
            let c = 0;
            const sn = setInterval(() => {
              addTermLine(`[${new Date().toLocaleTimeString()}] IP 192.168.1.${Math.floor(Math.random()*255)} > 10.0.0.1: TCP, length ${Math.floor(Math.random()*1000)}`);
              if (++c > 15) clearInterval(sn);
            }, 200);
          }
          else if (cmd === 'hex') {
            const s = args.slice(1).join(' ') || 'AndreaOsma';
            addTermLine(`Hex: ${s.split('').map(c => c.charCodeAt(0).toString(16)).join(' ')}`);
          }
          else if (cmd === 'cowsay') {
            const m = args.slice(1).join(' ') || 'Mooo!';
            addTermLine(`<pre style="line-height:1"> ${'_'.repeat(m.length + 2)}\n< ${m} >\n ${'-'.repeat(m.length + 2)}\n        \\   ^__^\n         \\  (oo)\\_______\n            (__)\\       )\\/\\\n                ||----w |\n                ||     ||</pre>`);
          }
          else if (cmd === 'matrix') {
            document.documentElement.dataset.theme = 'matrix'; addTermLine('Matrix mode engaged.', 'success');
            const canvas = document.getElementById('matrix-canvas');
            if (canvas) {
              canvas.style.display = 'block'; const ctx = canvas.getContext('2d');
              canvas.width = window.innerWidth; canvas.height = window.innerHeight;
              const chars = 'ｦｧｨｩｪｫｬｭｮｯｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789'.split(''); const fontSize = 16; const cols = canvas.width/fontSize; const drops = [];
              for(let x=0; x<cols; x++) drops[x] = 1;
              setInterval(() => {
                ctx.fillStyle = 'rgba(0,0,0,0.05)'; ctx.fillRect(0,0,canvas.width,canvas.height);
                ctx.fillStyle = '#0F0'; ctx.font = fontSize + 'px monospace';
                for(let i=0; i<drops.length; i++) {
                  ctx.fillText(chars[Math.floor(Math.random()*chars.length)], i*fontSize, drops[i]*fontSize);
                  if(drops[i]*fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
                  drops[i]++;
                }
              }, 33);
            }
          }
          else if (cmd === 'legacy') { document.documentElement.dataset.theme = 'legacy'; addTermLine('Legacy Mode active.'); }
          else if (cmd === 'tty') { document.body.classList.add('tty-mode'); addTermLine('TTY Mode.'); }
          else if (cmd === 'startx') { document.body.classList.remove('tty-mode'); }
          else if (cmd === 'ls') { const e = vfs[currentPath]; if (e) addTermLine(e.children.join('  ')); }
          else if (cmd === 'cd') {
            const d = args[1]; if (!d || d === '/') currentPath = '/';
            else if (d === '..') { if (currentPath !== '/') { const p = currentPath.split('/').filter(Boolean); p.pop(); currentPath = p.length ? '/' + p.join('/') + '/' : '/'; } }
            else { const n = currentPath + (d.endsWith('/') ? d : d + '/'); if (vfs[n]) currentPath = n; else addTermLine(`No dir: ${d}`, 'error'); }
          }
          else if (cmd === 'cat') {
            const f = args[1]; const p = currentPath + (f || '');
            if (vfs[p] && vfs[p].type === 'file') addTermLine(vfs[p].content); else addTermLine(`No file: ${f}`, 'error');
          }
          else if (cmd === 'play' && args[1] === 'starman') playStarman();
          else if (cmd === 'arkanoid') startArkanoid();
          else if (cmd === 'code') { fetch(window.location.href).then(r => r.text()).then(t => { sourceCode.textContent = t.slice(0,5000); sourceDialog.showModal(); }); }
          else if (cmd === 'submit') {
            const f = args[1]; if (ALL_FLAGS.includes(f)) { if (!foundFlags.includes(f)) { foundFlags.push(f); localStorage.setItem('ctf-flags', JSON.stringify(foundFlags)); addTermLine('FLAG VALIDATED.', 'success'); } } else addTermLine('Invalid.', 'error');
          }
          else if (cmd === 'status') addTermLine(`Flags: ${foundFlags.length}/${ALL_FLAGS.length}`);
          else if (cmd === 'clear') termBody.innerHTML = '';
          else if (cmd === 'exit') closeTerminal();
          else if (cmd !== '') addTermLine(`Unknown command: ${cmd}`, 'error');
        };

        // --- DRAGGABLE ---
        let isDragging = false; let dragOffset = { x: 0, y: 0 };
        termHeader?.addEventListener('mousedown', (e) => {
          if (document.body.classList.contains('tty-mode')) return;
          isDragging = true; const r = termDialog.getBoundingClientRect();
          dragOffset.x = e.clientX - r.left; dragOffset.y = e.clientY - r.top;
          termHeader.style.cursor = 'grabbing';
        });
        window.addEventListener('mousemove', (e) => {
          if (isDragging) {
            termDialog.style.left = `${e.clientX - dragOffset.x + termDialog.offsetWidth / 2}px`;
            termDialog.style.top = `${e.clientY - dragOffset.y + termDialog.offsetHeight / 2}px`;
          }
        });
        window.addEventListener('mouseup', () => { isDragging = false; if (termHeader) termHeader.style.cursor = 'grab'; });

        // --- KEYBOARD ---
        termInput?.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') { executeCommand(termInput.value); termInput.value = ''; }
          else if (e.key === 'ArrowUp') { e.preventDefault(); if (historyIndex < commandHistory.length - 1) { historyIndex++; termInput.value = commandHistory[historyIndex]; } }
          else if (e.key === 'ArrowDown') { e.preventDefault(); if (historyIndex > 0) { historyIndex--; termInput.value = commandHistory[historyIndex]; } else { historyIndex = -1; termInput.value = ''; } }
          else if (e.key === 'Tab') { e.preventDefault(); const v = termInput.value.toLowerCase(); const m = availableCommands.find(c => c.startsWith(v)); if (m) termInput.value = m; }
        });

        closeSource?.addEventListener('click', () => sourceDialog.close());

        // --- AFK MODE ---
        let afkTime = 0;
        const afkScreen = document.getElementById('afk-screen');
        const afkLogo = document.getElementById('afk-logo');
        let logoX = 50, logoY = 50, dX = 2, dY = 2;

        const resetAFK = () => {
          afkTime = 0;
          if (afkScreen) afkScreen.style.display = 'none';
        };
        window.addEventListener('mousemove', resetAFK);
        window.addEventListener('keydown', resetAFK);
        window.addEventListener('click', resetAFK);

        setInterval(() => {
          afkTime++;
          if (afkTime > 10000) { // ~5 minutos de inactividad (30ms * 10000)
            if (afkScreen) afkScreen.style.display = 'block';
            logoX += dX; logoY += dY;
            if (logoX <= 0 || logoX > window.innerWidth - 200) dX *= -1;
            if (logoY <= 0 || logoY > window.innerHeight - 50) dY *= -1;
            if (afkLogo) { afkLogo.style.left = logoX + 'px'; afkLogo.style.top = logoY + 'px'; }
          }
        }, 30);

        // --- SKY BACKGROUNDS ---
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const isDayTheme = () => document.documentElement.dataset.theme === 'light';
        const canAnimate = () => !document.hidden && !reduceMotion.matches;

        const cCanvas = document.getElementById('clouds-canvas');
        if (cCanvas) {
          const cCtx = cCanvas.getContext('2d');
          let clouds = [];
          const resizeClouds = () => {
            cCanvas.width = window.innerWidth;
            cCanvas.height = window.innerHeight;
          };
          const seedClouds = () => {
            clouds = Array.from({ length: 9 }, (_, idx) => ({
              x: Math.random() * cCanvas.width,
              y: (idx / 9) * cCanvas.height * 0.85 + Math.random() * 45,
              vx: 0.08 + Math.random() * 0.2,
              scale: 0.65 + Math.random() * 0.8,
              alpha: 0.14 + Math.random() * 0.12
            }));
          };
          window.addEventListener('resize', () => {
            resizeClouds();
            seedClouds();
          });
          resizeClouds();
          seedClouds();

          const drawCloud = (cloud) => {
            const base = 70 * cloud.scale;
            cCtx.beginPath();
            cCtx.ellipse(cloud.x, cloud.y, base * 0.95, base * 0.48, 0, 0, Math.PI * 2);
            cCtx.ellipse(cloud.x - base * 0.58, cloud.y + base * 0.08, base * 0.56, base * 0.34, 0, 0, Math.PI * 2);
            cCtx.ellipse(cloud.x + base * 0.62, cloud.y + base * 0.03, base * 0.63, base * 0.38, 0, 0, Math.PI * 2);
            cCtx.fillStyle = `rgba(255, 255, 255, ${cloud.alpha})`;
            cCtx.fill();
          };

          const animateClouds = () => {
            if (isDayTheme() && canAnimate()) {
              cCtx.clearRect(0, 0, cCanvas.width, cCanvas.height);
              clouds.forEach((cloud) => {
                cloud.x += cloud.vx;
                if (cloud.x > cCanvas.width + 120) cloud.x = -140;
                drawCloud(cloud);
              });
            } else if (!isDayTheme()) {
              cCtx.clearRect(0, 0, cCanvas.width, cCanvas.height);
            }
            requestAnimationFrame(animateClouds);
          };
          animateClouds();
        }

        // --- NODES CANVAS (constellation/night) ---
        const nCanvas = document.getElementById('nodes-canvas');
        if (nCanvas) {
          const ctx = nCanvas.getContext('2d');
          let pts = [];
          const resize = () => { nCanvas.width = window.innerWidth; nCanvas.height = window.innerHeight; };
          window.addEventListener('resize', resize); resize();
          for(let i=0; i<50; i++) pts.push({ x: Math.random()*nCanvas.width, y: Math.random()*nCanvas.height, vx: (Math.random()-0.5)*0.5, vy: (Math.random()-0.5)*0.5 });
          const animate = () => {
            if (!isDayTheme() && canAnimate()) {
              ctx.clearRect(0, 0, nCanvas.width, nCanvas.height);
              ctx.fillStyle = 'rgba(106, 169, 255, 0.5)';
              ctx.strokeStyle = 'rgba(106, 169, 255, 0.1)';
              pts.forEach((p, i) => {
                p.x += p.vx; p.y += p.vy;
                if (p.x < 0 || p.x > nCanvas.width) p.vx *= -1;
                if (p.y < 0 || p.y > nCanvas.height) p.vy *= -1;
                ctx.beginPath(); ctx.arc(p.x, p.y, 2, 0, Math.PI*2); ctx.fill();
                for(let j=i+1; j<pts.length; j++) {
                  const p2 = pts[j];
                  const d = Math.hypot(p.x - p2.x, p.y - p2.y);
                  if (d < 150) { ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p2.x, p2.y); ctx.stroke(); }
                }
              });
            } else if (isDayTheme()) {
              ctx.clearRect(0, 0, nCanvas.width, nCanvas.height);
            }
            requestAnimationFrame(animate);
          };
          animate();
        }

        // --- GRAVITY & ARKANOID (Matter.js) ---
        const loadMatter = (cb) => {
          if (window.Matter) return cb();
          const s = document.createElement('script');
          s.src = 'https://cdnjs.cloudflare.com/ajax/libs/matter-js/0.19.0/matter.min.js';
          s.onload = cb; document.head.appendChild(s);
        };

        const startArkanoid = () => {
          loadMatter(() => {
            closeTerminal();
            const { Engine, World, Bodies, Runner, Events } = Matter;
            const engine = Engine.create(); engine.world.gravity.y = 0;
            const cards = document.querySelectorAll('.card'); const bodies = [];
            cards.forEach(el => {
              const r = el.getBoundingClientRect();
              const b = Bodies.rectangle(r.left + r.width/2, r.top + r.height/2, r.width, r.height, { isStatic: true, label: 'brick' });
              el.style.position = 'fixed'; el.style.width = r.width + 'px'; el.style.height = r.height + 'px';
              bodies.push({ el, body: b }); World.add(engine.world, b);
            });
            const ball = Bodies.circle(window.innerWidth/2, window.innerHeight - 200, 10, { restitution: 1, friction: 0, frictionAir: 0, inertia: Infinity, label: 'ball' });
            Matter.Body.setVelocity(ball, { x: 5, y: -5 });
            const paddle = Bodies.rectangle(window.innerWidth/2, window.innerHeight - 50, 150, 20, { isStatic: true, label: 'paddle' });
            World.add(engine.world, [ball, paddle]);
            World.add(engine.world, [Bodies.rectangle(window.innerWidth/2, -10, window.innerWidth, 20, { isStatic: true }), Bodies.rectangle(-10, window.innerHeight/2, 20, window.innerHeight, { isStatic: true }), Bodies.rectangle(window.innerWidth + 10, window.innerHeight/2, 20, window.innerHeight, { isStatic: true })]);
            Runner.run(engine);
            window.addEventListener('mousemove', (e) => Matter.Body.setPosition(paddle, { x: e.clientX, y: window.innerHeight - 50 }));
            Events.on(engine, 'collisionStart', (e) => {
              e.pairs.forEach(pair => {
                const brick = pair.bodyA.label === 'brick' ? pair.bodyA : (pair.bodyB.label === 'brick' ? pair.bodyB : null);
                if (brick) { const bObj = bodies.find(b => b.body === brick); if (bObj) { bObj.el.style.display = 'none'; World.remove(engine.world, brick); } }
              });
            });
            (function rerender() {
              bodies.forEach(({ el, body }) => { el.style.left = (body.position.x - el.offsetWidth/2) + 'px'; el.style.top = (body.position.y - el.offsetHeight/2) + 'px'; el.style.transform = `rotate(${body.angle}rad)`; });
              ball.el = ball.el || (()=>{const d = document.createElement('div'); d.style.position='fixed'; d.style.width='20px'; d.style.height='20px'; d.style.background='var(--accent)'; d.style.borderRadius='50%'; d.style.zIndex='20000'; document.body.appendChild(d); return d;})();
              ball.el.style.left = (ball.position.x - 10) + 'px'; ball.el.style.top = (ball.position.y - 10) + 'px';
              paddle.el = paddle.el || (()=>{const d = document.createElement('div'); d.style.position='fixed'; d.style.width='150px'; d.style.height='20px'; d.style.background='#fff'; d.style.borderRadius='10px'; d.style.zIndex='20000'; document.body.appendChild(d); return d;})();
              paddle.el.style.left = (paddle.position.x - 75) + 'px'; paddle.el.style.top = (paddle.position.y - 10) + 'px';
              if (ball.position.y > window.innerHeight) Matter.Body.setPosition(ball, {x: window.innerWidth/2, y: window.innerHeight - 200});
              requestAnimationFrame(rerender);
            })();
          });
        };

        const loadGravity = () => {
          loadMatter(() => {
            closeTerminal();
            const { Engine, World, Bodies, Runner, MouseConstraint, Mouse } = Matter;
            const engine = Engine.create();
            const cards = document.querySelectorAll('.card'); const bodies = [];
            cards.forEach(el => {
              const r = el.getBoundingClientRect();
              const b = Bodies.rectangle(r.left + r.width/2, r.top + r.height/2, r.width, r.height);
              el.style.position = 'fixed'; el.style.width = r.width + 'px'; el.style.height = r.height + 'px'; el.style.zIndex = '1000';
              bodies.push({ el, body: b }); World.add(engine.world, b);
            });
            const ground = Bodies.rectangle(window.innerWidth/2, window.innerHeight + 50, window.innerWidth, 100, { isStatic: true });
            World.add(engine.world, [ground, Bodies.rectangle(-50, window.innerHeight/2, 100, window.innerHeight, { isStatic: true }), Bodies.rectangle(window.innerWidth + 50, window.innerHeight/2, 100, window.innerHeight, { isStatic: true })]);
            const mouseConstraint = MouseConstraint.create(engine, { mouse: Mouse.create(document.body), constraint: { stiffness: 0.2 } });
            World.add(engine.world, mouseConstraint); Runner.run(engine);
            (function rerender() { bodies.forEach(({ el, body }) => { el.style.left = (body.position.x - el.offsetWidth/2) + 'px'; el.style.top = (body.position.y - el.offsetHeight/2) + 'px'; el.style.transform = `rotate(${body.angle}rad)`; }); requestAnimationFrame(rerender); })();
          });
        };

        // --- GITHUB ---
        const fetchLastSeen = async () => {
          try {
            const res = await fetch(`https://api.github.com/users/AndreaOsma/events/public`);
            const events = await res.json();
            const lastPush = events.find(e => e.type === 'PushEvent');
            if (lastPush) {
              const date = new Date(lastPush.created_at);
              const diff = Math.floor((new Date() - date) / 1000 / 60);
              let timeStr = diff < 60 ? `${diff}m` : diff < 1440 ? `${Math.floor(diff/60)}h` : `${Math.floor(diff/1440)}d`;
              const statusText = document.getElementById('gh-status');
              if (statusText) statusText.innerHTML += ` <span style="opacity:0.6; font-size: 0.9em; margin-left: 0.5rem;">| Coding ${timeStr} ago</span>`;
            }
          } catch (e) {}
        };
        fetchLastSeen();

        // --- MOUSE GLOW ---
        const glow = document.querySelector('.glow-layer');
        document.addEventListener('mousemove', (e) => { if (glow) { glow.style.setProperty('--mouse-x', `${e.clientX}px`); glow.style.setProperty('--mouse-y', `${e.clientY}px`); } });

        // --- FAVICON ---
        const favicon = document.getElementById('dynamic-favicon');
        if (favicon) {
          favicon.href = `data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🌙</text></svg>`;
        }
        
        // --- PILL FILTERS ---
        const pills = document.querySelectorAll('.pill');
        const projects = document.querySelectorAll('.project-card');
        pills.forEach(pill => {
          pill.addEventListener('click', () => {
            const filter = pill.dataset.filter.toLowerCase();
            pills.forEach(p => p.classList.remove('active')); pill.classList.add('active');
            projects.forEach(project => {
              const tags = project.dataset.tags;
              if (filter === 'all' || tags.includes(filter)) { project.style.display = 'flex'; project.style.opacity = '1'; }
              else { project.style.display = 'none'; project.style.opacity = '0'; }
            });
          });
        });
      });
    </script>
  </body>
</html>
